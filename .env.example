# Copy this file to `.env` and fill in the values you have. Every setting
# has a safe default, so the app runs fully offline (heuristic entity/
# relationship extraction, in-memory graph, hashing-based embeddings)
# even if you leave everything blank.

# ---------------------------------------------------------------------------
# LLM provider (used for entity/relationship extraction and answer generation)
# ---------------------------------------------------------------------------
# One of: openai | groq | gemini | none
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Only needed for custom OpenAI-compatible endpoints; Groq's default is set automatically.
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=data/embedding_cache

# ---------------------------------------------------------------------------
# Neo4j (leave NEO4J_ENABLED=false to use the built-in in-memory graph store)
# ---------------------------------------------------------------------------
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
MAX_CHUNK_CHARS=1800
MIN_CHUNK_CHARS=200
CHUNK_OVERLAP_RATIO=0.15

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
TOP_K_VECTOR=6
TOP_K_GRAPH_NEIGHBORS=15
GRAPH_EXPANSION_HOPS=1

# ---------------------------------------------------------------------------
# Paths (defaults are fine for most setups)
# ---------------------------------------------------------------------------
DATA_DIR=data
UPLOAD_DIR=data/uploads
VECTOR_INDEX_DIR=data/vector_index
GRAPH_CACHE_DIR=data/graph_cache
